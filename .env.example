# Supabase Configuration
# Replace these values with your actual project credentials from the Supabase dashboard (Project Settings > API)

# Default Local Development
VITE_APP_ENV=development
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# App base URL (used by serverless functions to construct callback redirects)
VITE_APP_URL=http://localhost:5173

# WhatsApp Concierge Hotline (Country code + phone without + or spaces, e.g. 201000000000)
VITE_WHATSAPP_NUMBER=201000000000

# Google Analytics 4 Measurement ID (optional — leave blank to disable analytics)
# Get yours from: https://analytics.google.com → Admin → Data Streams → Measurement ID
VITE_GA_MEASUREMENT_ID=

# Paymob Payment Gateway (https://accept.paymob.com)
# PAYMOB_API_KEY              = v3 API Key from Paymob dashboard
# PAYMOB_INTEGRATION_ID       = Default integration ID (fallback)
# PAYMOB_INTEGRATION_ID_CARD  = Specific integration ID for Cards (Visa/Mastercard/Meeza)
# PAYMOB_INTEGRATION_ID_WALLET= Specific integration ID for Mobile Wallets (Vodafone Cash, etc.)
# PAYMOB_INTEGRATION_ID_VALU  = Specific integration ID for ValU BNPL
# PAYMOB_INTEGRATION_ID_SYMPL = Specific integration ID for Sympl BNPL
# PAYMOB_HMAC_SECRET          = HMAC secret from Paymob dashboard → Developers → Webhooks
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_INTEGRATION_ID_VALU=
PAYMOB_INTEGRATION_ID_SYMPL=
PAYMOB_HMAC_SECRET=

# Brevo Transactional Email (https://app.brevo.com → SMTP & API → API Keys)
# BREVO_API_KEY       = your Brevo v3 API key
# BREVO_SENDER_EMAIL  = a verified sender address in your Brevo account
BREVO_API_KEY=
BREVO_SENDER_EMAIL=orders@yourdomain.com

# Supabase service role key (for webhook serverless function — never expose to browser!)
# SUPABASE_SERVICE_ROLE_KEY = from Supabase dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=https://your-project-ref.supabase.co

# Vercel Cron Security Secret (optional, configured in Vercel project settings)
CRON_SECRET=

# Staging Environment: create .env.staging (loaded via `npm run dev:staging`)
# Production Environment: create .env.production (loaded via `npm run build:production`)
